# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnpm-debug.log*

# Production builds
dist
dist-ssr
build

# Environment variables (contains sensitive API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Wrangler 本地 secrets（ADMIN_SECRET 等），绝不入库
.dev.vars
.dev.vars.*
# 本机测试凭据（AI Key 等）。刻意与 .dev.vars 分开：
# .dev.vars 会被 wrangler 注入 Worker 环境，而契约要求 AI Key 不同步到 RSS 后端。
.secrets.env

# 原始验收证据已归档到仓库外，仅保留公开摘要
/docs/validation/**
!/docs/validation/验收记录.md
!/docs/validation/README.md
/.playwright-mcp/
/.kilo/
*.jks
*.keystore
*.apk
*.aab
/wrangler.local.toml

# Sensitive data directory（锚定到仓库根：上游规则未加前缀，会连带忽略
# Kotlin 包路径 .../nativeapp/data/**，导致源码无法入库）
/data/

# D1 导出/备份产生的数据快照：含订阅 URL，视为潜在敏感数据，不入库
d1-backup-*.sql
*.d1-export.sql

