# Copy the required values into a private .dev.vars for local Pages Functions.
# Do not commit .dev.vars or put AI keys in the RSS backend.
ADMIN_SECRET=replace-with-your-own-strong-secret
ALLOWED_ORIGINS=
ENABLE_DEBUG_ROUTE=false

# Optional Neon fallback; prefer the D1 binding configured in wrangler.toml.
# DATABASE_URL=postgresql://user:password@host.example/dbname?sslmode=require
# ARTICLE_EXTRACT_MAX_BYTES=5242880
